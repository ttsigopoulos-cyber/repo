# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
# Not used by this app (all database access is server-side), kept for consistency with the setup guide
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Google AI Studio (Gemini) ---
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash. Check current names at ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=

# --- Blockchain (local Hardhat chain) ---
NEXT_PUBLIC_CHAIN_ID=31337
# Printed by: npx hardhat ignition deploy ignition/modules/InterviewRegistry.ts --network localhost
NEXT_PUBLIC_CONTRACT_ADDRESS=
RPC_URL=http://127.0.0.1:8545
# Private key of Hardhat "Account #1" as printed by `npx hardhat node` (public test key, local only!)
RELAYER_PRIVATE_KEY=
# Optional, e.g. https://sepolia.etherscan.io/tx/  (leave empty for the local chain)
NEXT_PUBLIC_EXPLORER_TX_URL=

# --- App ---
# At least 8 characters; gives access to /forschung
RESEARCH_ACCESS_CODE=
# Interviews with relatives stay off until the preconditions in the questionnaire (block C6-C9) are met
NEXT_PUBLIC_ENABLE_FAMILY=false
